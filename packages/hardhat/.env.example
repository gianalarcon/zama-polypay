# Polypay-Zama hardhat env.
#
# Defaults in hardhat.config.ts cover local dev:
#   SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com  (when no Alchemy key)
#
# REQUIRED for `yarn deploy --network sepolia`:

# Private key of the EOA paying gas for contract deploys.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Address of the relayer EOA (constructor arg for HiddenERC20 + HiddenMultisig).
# Same EOA that the backend uses as RELAYER_PRIVATE_KEY.
RELAYER_ADDRESS=0xYOUR_RELAYER_ADDRESS

# OPTIONAL — supply for faster Sepolia RPC + etherscan verify.
# ALCHEMY_API_KEY=
# ETHERSCAN_API_KEY=
# SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
